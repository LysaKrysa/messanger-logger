[Unit]
Description=Messenger shared Telegram gateway and invitation receiver
After=network-online.target
Wants=network-online.target

[Service]
User=messenger-dashboard
Group=messenger-dashboard
WorkingDirectory=/opt/messenger-dashboard/app
EnvironmentFile=/etc/messenger-dashboard/service.env
ExecStart=/opt/messenger-dashboard/venv/bin/gunicorn --config dashboard/gunicorn.py --bind 127.0.0.1:8788 dashboard.broker:create_app()
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/messenger-dashboard
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
